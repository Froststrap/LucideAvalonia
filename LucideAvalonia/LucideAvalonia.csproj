<Project Sdk="Microsoft.NET.Sdk">

  <!-- Basic project configuration -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- NuGet package information -->
  <PropertyGroup>
    <Title>LucideAvalonia</Title>
    <Authors>Marwan</Authors>
    <Description>A library for AvaloniaUI that integrates Lucide icons into your Avalonia applications.</Description>
    <Copyright>Marwan</Copyright>
    <PackageProjectUrl>https://github.com/Froststrap/LucideAvalonia</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Froststrap/LucideAvalonia</RepositoryUrl>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Froststrap.LucideAvalonia</PackageId>
    <Version>1.6.2</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Avalonia" Version="12.0.5" />
  </ItemGroup>
</Project>
