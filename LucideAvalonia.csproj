<Project Sdk="Microsoft.NET.Sdk">

  <!-- Basic project configuration -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- NuGet package information -->
  <PropertyGroup>
    <Authors>Froststrap; Invra</Authors>
    <Description>A fork of library https://github.com/MarwanFr/LucideAvaloniaUI for better internal tooling for Froststrap usage.</Description>
    <Copyright>Froststrap</Copyright>
    <PackageProjectUrl>https://github.com/Froststrap/LucideAvalonia</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Froststrap/LucideAvalonia</RepositoryUrl>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Froststrap.LucideAvalonia</PackageId>
    <PackageTags>icons;avalonia;ui;user-interface;aot;dotnet10</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>2.0.1</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
  	<PackageReference Include="Avalonia" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
